#version 450
// glitch_disp.comp — DISPERSION: a prism / lens that bends each wavelength differently.
//
// Glass has a wavelength-dependent refractive index; Cauchy's approximation
//     n(λ) ≈ A + B/λ²
// so short (blue) wavelengths bend more than long (red) ones. We render that as a per-
// wavelength image displacement proportional to n(λ) − n(550 nm):
//     k(λ) = (1/λ² − 1/550²) / (1/400² − 1/700²)        (≈ −0.37 at 700 nm, +0.63 at 400 nm)
//     offset(λ) = k(λ) · depth · dir(p)
// dir(p) is either RADIAL (distance from the frame centre, like lateral chromatic aberration
// of a lens: no shift at the centre, most at the edges) or a fixed DIRECTION (a prism).
// Instead of three R/G/B taps we integrate wavelengths from 400–700 nm and weight each by a
// Gaussian approximation of the R, G, B colour-matching responses, normalized per channel, so
// a white point stays white. For the spread to be a continuous rainbow rather than separate
// ghost copies, neighbouring taps must land ≤ ~1.5 px apart. So the taps are spaced evenly in
// k (= evenly in displacement, not in λ: k changes 4× faster per nm at 400 than at 700), their
// count n follows the local spread |k range|·depth·|dir| (7 .. 64), each tap's λ is the
// inverse of k(λ), and its weight carries the Jacobian |dλ/dk| = λ³/(2·kn) so the sum is still
// an integral over wavelength. Each tap is jittered within its stratum by a per-pixel hash,
// which turns any remaining gap (huge depths that hit the 64 cap) into fine grain, not copies.
#include "glitch_common.glsl"
layout(local_size_x = 16, local_size_y = 16) in;

vec3 response(float lambda) {   // rough R/G/B sensitivities (nm)
    return vec3(exp(-pow((lambda - 605.0) / 50.0, 2.0)),
                exp(-pow((lambda - 545.0) / 42.0, 2.0)),
                exp(-pow((lambda - 450.0) / 36.0, 2.0)));
}

void main() {
    ivec2 size = imageSize(src);
    ivec2 px = ivec2(gl_GlobalInvocationID.xy);
    if (px.x >= size.x || px.y >= size.y) return;
    vec2 p = vec2(px);
    float scale = float(size.y) / 1080.0;
    vec2 dir;
    if (g.disp.y < 0.5) {
        // radial, with a falloff that peaks around the silhouette (r ≈ 0.45 of the half-height,
        // where the form's edge sits) instead of growing toward the empty frame corners
        vec2 rv = (p - 0.5 * vec2(size)) / (0.5 * float(size.y));
        float r = length(rv);
        float fall = 0.25 + 1.5 * exp(-(r - 0.45) * (r - 0.45) / 0.09);
        dir = rv / max(r, 1e-3) * min(r / 0.15, 1.0) * fall;
    } else {
        dir = vec2(cos(g.disp.z), sin(g.disp.z));
    }
    // minimum split (disp.w px at 1080p): any dispatched kick is a visible colour split
    float dl = length(dir) * abs(g.disp.x);
    if (dl > 1e-4 && dl < g.disp.w) dir *= g.disp.w / dl;
    vec3 acc = vec3(0.0);
    vec3 wsum = vec3(0.0);
    const float kn = 1.0 / (1.0 / (400.0 * 400.0) - 1.0 / (700.0 * 700.0));
    const float inv550 = 1.0 / (550.0 * 550.0);
    const float k_hi = (1.0 / (400.0 * 400.0) - inv550) * kn;   // ≈ +0.70
    const float k_lo = (1.0 / (700.0 * 700.0) - inv550) * kn;   // ≈ −0.30 (k_hi − k_lo = 1)
    float spread = abs(g.disp.x * scale) * length(dir);          // px between k_lo and k_hi
    int n = clamp(int(ceil(spread / 1.5)), 7, 64);
    float jitter = hash21(p + 0.37);
    for (int i = 0; i < n; i++) {
        float k = mix(k_lo, k_hi, (float(i) + jitter) / float(n));
        float lambda = inversesqrt(k / kn + inv550);
        vec3 w = response(lambda) * (lambda * lambda * lambda);    // ∝ response · |dλ/dk|
        acc += w * bilinear(p + dir * (k * g.disp.x * scale), size);
        wsum += w;
    }
    imageStore(dst, px, vec4(acc / wsum, 1.0));
}
