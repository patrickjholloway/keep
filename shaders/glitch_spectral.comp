#version 450
// glitch_spectral.comp — SPECTRAL GATE: edit the picture's 2D Fourier spectrum.
//
// Any image is a sum of 2D sinusoids (plane waves). The 2D DFT
//     X[kx,ky] = Σ_x Σ_y x[x,y] · e^{−2πi (kx·x/N + ky·y/M)}
// gives the amplitude and phase of each one; |k| (radial frequency, cycles/pixel) says how
// FINE the wave is: low |k| = broad glow and overall shape, high |k| = edges, beads, grain.
// The gate multiplies a ring-shaped band lo ≤ |k| ≤ hi by (1 − atten), optionally bends the
// phases inside the band (structure at that scale splits into ghost echoes while its energy is
// kept — see FILTER below), then inverse-transforms.
//
// Pipeline (this one shader, selected by pc.p.x = mode; the CPU records the sequence):
//   0 LOAD       box-filter the frame down to IW×IH = 1024×512 and write its MIRROR (even)
//                extension into the 2048×1024 FFT grid (re = rgb, im = 0). See EDGES below.
//   1 STAGE      one radix-2 Stockham butterfly stage along rows or columns (log2 N of them)
//   2 FILTER     per frequency bin: band gain + phase scramble
//   3 COMPOSITE  out = orig + mix · gate · (up(filtered) − up(down(orig)))
//                i.e. only the CHANGE the filter made is added at full resolution, so the
//                downsampling to the working grid never blurs the untouched picture.
//                gate = smoothstep(0.02, 0.15, local luma) keeps echoes off empty black.
//
// Stockham radix-2 (Ns = 1, 2, 4, …, L/2; thread j = 0 .. L/2−1 per line):
//     k = j mod Ns,  v0 = x[j],  v1 = x[j + L/2] · e^{∓iπ k/Ns}
//     y[(j−k)·2 + k] = v0 + v1,   y[(j−k)·2 + k + Ns] = v0 − v1
// Each stage reads one buffer and writes the other ("autosort": the output comes out in
// natural order with no bit-reversal pass). Forward = rows then columns, inverse = the same
// with the conjugate twiddle and a 1/(N·M) scale at the end. src/glitch.rs has the CPU twin.
// The gains and phase edits are symmetric (gain even, phase odd in f), so the inverse is real;
// we keep the real part, the imaginary part is only rounding noise.
//
// EDGES. A DFT treats its grid as a torus: the bottom row sits next to the top row. A frame
// whose top and bottom differ (sky over ground) has a step at that seam, a band cut rings
// across it, and the phase echo (a circular shift by D) copies bottom-edge content onto the
// top rows. So the frame is mirrored into a grid twice its size in each axis:
//     grid(x, y) = img(mirror(x), mirror(y)),  mirror(x) = x < IW ? x : 2·IW − 1 − x
// The periodic extension of that is continuous everywhere (a DCT-II style even extension), so
// there is no seam to ring on, and an echo that runs off one edge reflects back instead of
// wrapping round to the opposite side. COMPOSITE only reads the original IW×IH quadrant.
//
// UNITS. lo / hi / soft are cycles per working-grid pixel measured on the VERTICAL axis
// (IH grid px = frame height). Horizontal frequencies are rescaled by the frame's aspect, so
// the band is a circle in image space whatever the frame shape, and the echo offset D is an
// isotropic distance (26 vertical grid px ≈ 55 px at 1080p).
#include "glitch_common.glsl"
layout(local_size_x = 256) in;

#define FN 2048u   // FFT grid width  (power of two) = 2·IW (mirror extension)
#define FM 1024u   // FFT grid height (power of two) = 2·IH
#define IW 1024    // image quadrant width
#define IH 512     // image quadrant height

Cplx rd(uint i) {
    if ((pc.p.z & 4u) != 0u) { return fb[i]; }
    return fa[i];
}
void wr_other(uint i, Cplx v) {          // stage output: the buffer we are NOT reading
    if ((pc.p.z & 4u) != 0u) { fa[i] = v; } else { fb[i] = v; }
}
void wr_same(uint i, Cplx v) {           // in-place filter
    if ((pc.p.z & 4u) != 0u) { fb[i] = v; } else { fa[i] = v; }
}

// Frame -> working grid: box prefilter over the cell's footprint (one grid cell covers
// size/(IW, IH) ≈ 1.9×2.1 frame px at 1080p) as 4 bilinear taps at ±¼ cell. A single bilinear
// tap would skip about half the source rows and columns and alias fine detail into the band.
vec3 down(ivec2 cell, ivec2 size) {
    cell = clamp(cell, ivec2(0), ivec2(IW - 1, IH - 1));
    vec2 step_px = vec2(size) / vec2(IW, IH);
    vec2 p = (vec2(cell) + 0.5) * step_px - 0.5;
    vec2 hi = vec2(size - 1);
    vec2 o = 0.25 * step_px;
    return 0.25 * (bilinear(clamp(p + vec2(-o.x, -o.y), vec2(0.0), hi), size)
                 + bilinear(clamp(p + vec2( o.x, -o.y), vec2(0.0), hi), size)
                 + bilinear(clamp(p + vec2(-o.x,  o.y), vec2(0.0), hi), size)
                 + bilinear(clamp(p + vec2( o.x,  o.y), vec2(0.0), hi), size));
}
vec3 grid_re(ivec2 cell) {
    cell = clamp(cell, ivec2(0), ivec2(IW - 1, IH - 1));
    return rd(uint(cell.y) * FN + uint(cell.x)).re.rgb;
}
int mirror(int x, int n) { return x < n ? x : 2 * n - 1 - x; }

void main() {
    uint mode = pc.p.x;
    uint id = gl_GlobalInvocationID.x;
    ivec2 size = imageSize(src);

    if (mode == 0u) {                                    // LOAD
        if (id >= FN * FM) return;
        ivec2 cell = ivec2(mirror(int(id % FN), IW), mirror(int(id / FN), IH));
        fa[id] = Cplx(vec4(down(cell, size), 0.0), vec4(0.0));
    } else if (mode == 1u) {                             // STAGE
        bool cols = (pc.p.z & 1u) != 0u;
        float sgn = (pc.p.z & 2u) != 0u ? 1.0 : -1.0;    // forward e^{-i..}, inverse e^{+i..}
        uint L = cols ? FM : FN;
        uint half_l = L / 2u;
        if (id >= half_l * (cols ? FN : FM)) return;
        uint line = id / half_l;
        uint j = id % half_l;
        uint ns = pc.p.y;
        uint k = j % ns;
        // element index of position i on this line
        uint base = cols ? line : line * FN;
        uint stride = cols ? FN : 1u;
        Cplx v0 = rd(base + j * stride);
        Cplx v1 = rd(base + (j + half_l) * stride);
        float ang = sgn * PI * float(k) / float(ns);
        vec2 w = vec2(cos(ang), sin(ang));
        vec3 r1 = v1.re.rgb * w.x - v1.im.rgb * w.y;     // v1 *= w   (complex, per channel)
        vec3 i1 = v1.re.rgb * w.y + v1.im.rgb * w.x;
        uint o = (j - k) * 2u + k;
        wr_other(base + o * stride, Cplx(vec4(v0.re.rgb + r1, 0.0), vec4(v0.im.rgb + i1, 0.0)));
        wr_other(base + (o + ns) * stride, Cplx(vec4(v0.re.rgb - r1, 0.0), vec4(v0.im.rgb - i1, 0.0)));
    } else if (mode == 2u) {                             // FILTER
        if (id >= FN * FM) return;
        uint kx = id % FN, ky = id / FN;
        // bins above N/2 are negative frequencies
        float fx = (kx <= FN / 2u ? float(kx) : float(kx) - float(FN)) / float(FN);
        float fy = (ky <= FM / 2u ? float(ky) : float(ky) - float(FM)) / float(FM);
        // isotropic units: cycles per grid px on the vertical axis (see UNITS above). One
        // vertical grid px is size.y/IH frame px; one horizontal one is size.x/IW.
        fx *= (float(size.y) / float(IH)) / (float(size.x) / float(IW));
        float f = length(vec2(fx, fy));
        if (f == 0.0) return;                            // DC (the mean) always passes
        float soft = g.spec2.z;
        float band = smoothstep(g.spec.y - soft, g.spec.y + soft, f) * (1.0 - smoothstep(g.spec.z - soft, g.spec.z + soft, f));
        float gain = band * (1.0 - g.spec.w) + (1.0 - band) * g.spec2.w;
        // Phase edit = MULTIPATH GHOSTING. A phase that varies sinusoidally with frequency,
        //     θ(f) = A · sin(2π f·D),     A = phase·π,   D = echo offset (grid pixels)
        // expands (Jacobi–Anger) into e^{iθ} = Σ_n J_n(A) e^{i 2π n f·D}: copies of the band's
        // content shifted by n·D with Bessel weights J_n(A) — echoes, like a TV picking up a
        // reflected signal. Only fine structure inside the band ghosts; the broad form stays.
        // θ is odd in f, so Hermitian symmetry (= a real-valued image) is preserved exactly.
        // `seed` picks the echo direction (golden-angle steps, so successive seeds spread out).
        float ang_d = g.spec2.y * 2.39996;
        vec2 D = 26.0 * vec2(cos(ang_d), sin(ang_d));
        float theta = g.spec2.x * band * PI * sin(2.0 * PI * dot(vec2(fx, fy), D));
        vec2 w = gain * vec2(cos(theta), sin(theta));
        Cplx v = rd(id);
        wr_same(id, Cplx(vec4(v.re.rgb * w.x - v.im.rgb * w.y, 0.0), vec4(v.re.rgb * w.y + v.im.rgb * w.x, 0.0)));
    } else {                                             // COMPOSITE (one thread per image pixel)
        if (id >= uint(size.x * size.y)) return;
        ivec2 px = ivec2(int(id % uint(size.x)), int(id / uint(size.x)));
        vec2 u = (vec2(px) + 0.5) * vec2(IW, IH) / vec2(size) - 0.5;   // pixel -> grid coords
        vec2 fl = floor(u);
        vec2 t = u - fl;
        ivec2 c = ivec2(fl);
        float norm = 1.0 / float(FN * FM);
        vec3 f00 = grid_re(c) * norm,               d00 = down(c, size);
        vec3 f10 = grid_re(c + ivec2(1, 0)) * norm, d10 = down(c + ivec2(1, 0), size);
        vec3 f01 = grid_re(c + ivec2(0, 1)) * norm, d01 = down(c + ivec2(0, 1), size);
        vec3 f11 = grid_re(c + ivec2(1, 1)) * norm, d11 = down(c + ivec2(1, 1), size);
        vec3 delta = mix(mix(f00 - d00, f10 - d10, t.x), mix(f01 - d01, f11 - d11, t.x), t.y);
        // Brightness gate: echoes only over or near the form. The working-grid sample is a
        // ~2 px box blur; taking the max of its four taps reaches a little past the edge.
        // Empty black (luma < 0.02) gets no ripple rings; full effect from luma 0.15 up.
        vec3 lw = vec3(0.2126, 0.7152, 0.0722);
        float near = max(max(dot(d00, lw), dot(d10, lw)), max(dot(d01, lw), dot(d11, lw)));
        float gate = smoothstep(0.02, 0.15, near);
        vec3 o = max(imageLoad(src, px).rgb + g.spec.x * gate * delta, vec3(0.0));
        imageStore(dst, px, vec4(o, 1.0));
    }
}
