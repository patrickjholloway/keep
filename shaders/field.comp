#version 450
// field.comp — one invocation per particle.
//   p4 = (x, y, z, w_slice);  q = A^-1 (p4 - t);  d = F(q)
// Particles with |d| < surface_width become visible droplets.
#include "common.glsl"
layout(local_size_x = 256) in;

layout(std430, set = 0, binding = 1) readonly buffer Seeds { vec4 seeds[]; };   // xyz = rest position, w = random
layout(std430, set = 0, binding = 2) buffer Out { Droplet droplets[]; };

#include "field.glsl"

// Approximate blackbody color (Tanner Helland fit), linear-ish RGB in [0,1].
vec3 blackbody(float kelvin) {
    float t = kelvin / 100.0;
    float r = t <= 66.0 ? 1.0 : clamp(1.292936 * pow(t - 60.0, -0.1332047592), 0.0, 1.0);
    float g = t <= 66.0 ? clamp(0.3900815788 * log(t) - 0.6318414438, 0.0, 1.0)
                        : clamp(1.1298908609 * pow(t - 60.0, -0.0755148492), 0.0, 1.0);
    float b = t >= 66.0 ? 1.0 : (t <= 19.0 ? 0.0 : clamp(0.5432067891 * log(t - 10.0) - 1.1962540891, 0.0, 1.0));
    return vec3(r, g, b);
}

void main() {
    uint id = gl_GlobalInvocationID.x;
    if (id >= scene.counts.x) return;
    vec4 s = seeds[id];
    vec4 p4 = vec4(s.xyz, scene.slice.x);
    float d = field(p4);
    float eps = scene.slice.y;

    // Central-difference gradient in xyz (the slice is 3D, so the visible normal is 3D).
    float h = 1e-3;
    vec3 g = vec3(field(p4 + vec4(h, 0, 0, 0)) - field(p4 - vec4(h, 0, 0, 0)),
                  field(p4 + vec4(0, h, 0, 0)) - field(p4 - vec4(0, h, 0, 0)),
                  field(p4 + vec4(0, 0, h, 0)) - field(p4 - vec4(0, 0, h, 0)));
    vec3 n = normalize(g + vec3(1e-9));
    // The 4th gradient component dF/dw says how the surface moves as the slice advances:
    // dF/dw relative to |grad_xyz| ~ "is this part of the cross-section growing or shrinking in w?"
    // We tint by it (cyan one way, magenta the other) so 4D depth reads as colour.
    float gw = field(p4 + vec4(0, 0, 0, h)) - field(p4 - vec4(0, 0, 0, h));
    float wslope = clamp(gw / (length(g) + abs(gw) + 1e-6), -1.0, 1.0);   // -1..1

    float vis = 1.0 - smoothstep(0.0, eps, abs(d));        // 1 on the surface, 0 beyond eps
    // Interpolate temperature in LOG space with an ease-in, so most of the shell sits at the warm
    // (orange-red) end and only the outer edge reaches the hot blue-white end. A linear mix put
    // the bulk at ~6500K, which is just off-white.
    float sx = clamp(0.5 + 0.5 * d / eps, 0.0, 1.0);
    float temp = scene.material.x * pow(scene.material.y / scene.material.x, sx * sx);
    Droplet o;
    o.pos_size = vec4(s.xyz, vis > 0.0 ? scene.slice.z * (0.6 + 0.4 * vis) : 0.0);
    o.normal_d = vec4(n, d);
    // --- Colour: saturated blackbody ---------------------------------------------------------
    // The raw Helland fit is pastel (every channel > 0.3 across most of the range). We:
    //   1. pin the cold end (~1000-1800K) to a deep red-orange,
    //   2. pin the hot end toward blue-white instead of neutral white,
    //   3. push saturation away from grey by 1.8x (mix(grey, col, 1.8) extrapolates past col).
    vec3 bb = blackbody(temp);
    bb = mix(vec3(1.0, 0.25, 0.05), bb, smoothstep(1000.0, 1800.0, temp));
    bb = mix(bb, vec3(0.55, 0.75, 1.0), smoothstep(6500.0, 12000.0, temp));
    float bl = dot(bb, vec3(0.2126, 0.7152, 0.0722));
    bb = max(mix(vec3(bl), bb, 1.8), 0.0);
    // w-slope accent, scaled by 0.6 so cyan/magenta tints rather than dragging toward pink.
    vec3 accent = wslope > 0.0 ? vec3(0.05, 0.85, 1.0) : vec3(1.0, 0.1, 0.75);   // cyan / magenta
    vec3 col = mix(bb, accent, 0.6 * 0.55 * abs(wslope));
    // Edge-on term: where the surface normal is perpendicular to the view ray we are looking
    // along the surface, so silhouettes, outlines and pinch-off necks get brighter.
    vec3 vdir = normalize(scene.cam_pos.xyz - s.xyz);
    float edge = 1.0 - abs(dot(n, vdir));
    col *= 0.75 + 0.9 * edge * edge * edge;
    o.emission = vec4(col * scene.material.w, vis);
    droplets[id] = o;
}
