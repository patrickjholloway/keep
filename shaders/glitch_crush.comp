#version 450
// glitch_crush.comp — BITCRUSH + SAMPLE-AND-HOLD.
//
// Sample-and-hold (decimation): the image is sampled only once per hold×hold block and that
// value is held across the block — the 2D version of lowering an audio sample rate.
// Bitcrush (quantization): brightness snaps to L levels, the 2D version of lowering bit depth.
// HDR values are unbounded, so we quantize in a tone-compressed domain v = c/(1+c) ∈ [0,1),
// snap to the nearest of L evenly spaced levels (mid-tread: v → round(v·(L−1))/(L−1)), then
// expand back with c = v/(1−v). Mid-tread keeps black at exactly 0 (a mid-rise snap would lift
// it to ½/L, washing the whole background grey at low L). The top level v = 1 would be c = ∞,
// so it is clamped to (L − ½)/L, a finite c (= 3 at L = 2) rather than blown-out highlights. depth 0..1 maps to L = 2^(8 − 7·depth)
// (256 levels down to 2): smooth gradients turn into posterized contour bands.
#include "glitch_common.glsl"
layout(local_size_x = 16, local_size_y = 16) in;

void main() {
    ivec2 size = imageSize(src);
    ivec2 px = ivec2(gl_GlobalInvocationID.xy);
    if (px.x >= size.x || px.y >= size.y) return;
    int hold = max(int(g.crush.y), 1);
    ivec2 q = min((px / hold) * hold + hold / 2, size - 1);    // block centre: the held sample
    vec3 c = imageLoad(src, q).rgb;
    if (g.crush.x > 0.0) {
        float levels = exp2(8.0 - 7.0 * clamp(g.crush.x, 0.0, 1.0));
        vec3 v = c / (1.0 + c);
        v = min(round(v * (levels - 1.0)) / (levels - 1.0), vec3((levels - 0.5) / levels));
        c = v / (1.0 - v);
    }
    imageStore(dst, px, vec4(c, 1.0));
}
